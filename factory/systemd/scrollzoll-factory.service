[Unit]
Description=Scrollzoll Content-Fabrik (ein Lauf)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/scrollzoll/content
EnvironmentFile=%h/scrollzoll/factory.env
# PATH so setzen, dass claude, gh und git gefunden werden (ggf. anpassen: `which claude`)
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/scrollzoll/content/factory/run_batch.py
TimeoutStartSec=100min
Nice=10
