[Unit]
Description=Scrollzoll Content-Fabrik – Zeitplan

[Timer]
# Alle 2 Stunden ein Lauf (12/Tag). Wie viele davon wirklich laufen, begrenzt MAX_RUNS_PER_DAY
# in factory.env; ist das Nutzungslimit erreicht, endet ein Lauf sofort und ohne Fehler.
OnCalendar=*-*-* 00/2:20:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
