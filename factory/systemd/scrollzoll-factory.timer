[Unit]
Description=Scrollzoll Content-Fabrik – Zeitplan

[Timer]
# Vier Läufe pro Tag, je einer pro 5-Stunden-Fenster mit Abstand
OnCalendar=*-*-* 02:20:00
OnCalendar=*-*-* 08:20:00
OnCalendar=*-*-* 14:20:00
OnCalendar=*-*-* 20:20:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
